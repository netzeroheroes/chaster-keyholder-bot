LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-YOUR_KEY
LLM_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition
# Keep under remaining OpenRouter credits (default model wants 8192 otherwise → 402)
LLM_MAX_TOKENS=2048
LLM_ENABLE_TOOLS=false

OPENROUTER_APP_NAME=nsfw-chatbot
OPENROUTER_SITE_URL=http://localhost:8000

# Optional web PINs
DOMME_PIN=
SUB_PIN=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_DOMME_USER_ID=0
TELEGRAM_SUB_USER_ID=0
TELEGRAM_GROUP_CHAT_ID=0

IMAGE_ENABLED=true
IMAGE_MODEL=black-forest-labs/flux.2-pro
IMAGE_ASPECT_RATIO=3:4

CHASTER_CLIENT_ID=
CHASTER_CLIENT_SECRET=
CHASTER_REDIRECT_URI=http://127.0.0.1:8000/api/chaster/callback
CHASTER_SCOPES=profile locks keyholder
# CHASTER_ACCESS_TOKEN=
# CHASTER_LOCK_ID=
CHASTER_EXTENSION_SLUG=duo-domme

# Defaults for lock timings (Domme can override live in UI → data/runtime_controls.json)
AUTO_PUNISH_ENABLED=true
AUTO_PUNISH_SECONDS=600

# Unprompted bot teases inside a daily window (off by default)
AUTOPILOT_ENABLED=false
AUTOPILOT_TIMEZONE=Europe/London
AUTOPILOT_WINDOW_START=18:00
AUTOPILOT_WINDOW_END=23:00
AUTOPILOT_MIN_MINUTES=45
AUTOPILOT_MAX_MINUTES=120
AUTOPILOT_ALLOW_CHASTER=true
AUTOPILOT_CHASTER_CHANCE=0.35
AUTOPILOT_PUNISH_SECONDS=600

HOST=0.0.0.0
PORT=8000

# Chaster partner-extension iframe (public HTTPS host is fine — content is token-gated)
# Developer console → Main page URL:  https://YOUR-HOST/ext
#                    Config page URL: https://YOUR-HOST/ext/config
STANDALONE_UI_ENABLED=true
EXTENSION_DEV_BYPASS=false
# EXTENSION_FRAME_ANCESTORS=https://chaster.app https://*.chaster.app https://www.chaster.app
