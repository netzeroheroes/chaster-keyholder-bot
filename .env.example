LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-YOUR_KEY
# Cheap NSFW-friendly: gryphe/mythomax-l2-13b
# Free (often censors adult): openai/gpt-oss-20b:free
# Stronger paid NSFW: cognitivecomputations/dolphin-mistral-24b-venice-edition
LLM_MODEL=gryphe/mythomax-l2-13b
# Keep under remaining OpenRouter credits (default model wants 8192 otherwise → 402)
LLM_MAX_TOKENS=768
LLM_ENABLE_TOOLS=false

OPENROUTER_APP_NAME=nsfw-chatbot
OPENROUTER_SITE_URL=http://localhost:8000

# Optional web PINs
DOMME_PIN=
SUB_PIN=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_DOMME_USER_ID=0
TELEGRAM_SUB_USER_ID=0
TELEGRAM_GROUP_CHAT_ID=0

IMAGE_ENABLED=true
# Flux / Seedream use POST /api/v1/images — do not point IMAGE_MODEL at a chat-only slug
IMAGE_MODEL=black-forest-labs/flux.2-pro
IMAGE_FALLBACK_MODELS=bytedance-seed/seedream-4.5,black-forest-labs/flux.2-klein-4b,google/gemini-2.5-flash-image
IMAGE_ASPECT_RATIO=3:4

CHASTER_CLIENT_ID=
CHASTER_CLIENT_SECRET=
CHASTER_REDIRECT_URI=http://127.0.0.1:8000/api/chaster/callback
CHASTER_SCOPES=profile locks keyholder
# CHASTER_ACCESS_TOKEN=
# CHASTER_LOCK_ID=
CHASTER_EXTENSION_SLUG=duo-domme
# React in group chat when lock history events fire (extensions, share links, timer…)
LOCK_WATCH_ENABLED=true
LOCK_WATCH_SECONDS=45
# Duo Domme developer app → Extension URLs (same app as CHASTER_CLIENT_ID)
# URL: https://YOUR-HOST/api/chaster/webhook
# Event: action_log.created
# Basic auth optional unless CHASTER_WEBHOOK_REQUIRE_AUTH=true
CHASTER_WEBHOOK_USER=chaster-bot
CHASTER_WEBHOOK_PASSWORD=
CHASTER_WEBHOOK_REQUIRE_AUTH=false

# Research & Desire Lockbox (temporary Chaster ↔ physical box bridge)
# Dashboard → Settings → API Keys (Ultra). Docs: https://dev.researchanddesire.com/
# RAD_API_TOKEN=
# RAD_LOCKBOX_SYNC_ENABLED=true
# RAD_SYNC_HYGIENE=true
# RAD_MANUAL_ONLY=false\n# RAD_TIMER_SYNC_SECONDS=60
# Manual = no Chaster timer sync; lock/unlock (+ hygiene) only. Timer parked at 10y (API max).
# RAD_TARGET_USER_ID=0
# RAD_LOCK_SETTINGS_ID=8104
# (optional shell template — timer is overwritten from Chaster remaining time)
# Leave unset/0 to auto-pick the first template.
# RAD_KEYHOLDER_IDS=
# No R+D keyholder? leave empty and set RAD_IS_TEST_LOCK=true so hygiene can unlock.
# RAD_IS_TEST_LOCK=true

# Defaults for lock timings (Domme can override live in UI → data/runtime_controls.json)
AUTO_PUNISH_ENABLED=true
AUTO_PUNISH_SECONDS=600

# Unprompted bot teases inside a daily window (off by default)
AUTOPILOT_ENABLED=false
AUTOPILOT_TIMEZONE=Europe/London
AUTOPILOT_WINDOW_START=18:00
AUTOPILOT_WINDOW_END=23:00
AUTOPILOT_MIN_MINUTES=45
AUTOPILOT_MAX_MINUTES=120
AUTOPILOT_ALLOW_CHASTER=true
AUTOPILOT_CHASTER_CHANCE=0.35
AUTOPILOT_PUNISH_SECONDS=600

HOST=0.0.0.0
PORT=8000

# Chaster partner-extension iframe (public HTTPS host is fine — content is token-gated)
# Developer console → Main page URL:  https://YOUR-HOST/ext
#                    Config page URL: https://YOUR-HOST/ext/config
STANDALONE_UI_ENABLED=true
EXTENSION_DEV_BYPASS=false
# EXTENSION_FRAME_ANCESTORS=https://chaster.app https://*.chaster.app https://www.chaster.app
